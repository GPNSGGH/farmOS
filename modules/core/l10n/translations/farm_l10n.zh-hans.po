# FarmOS modules
msgid "farmOS Asset"
msgstr "农场管理系统资产"

msgid "Provides an asset entity type for real world record keeping."
msgstr "提供用于现实世界记录管理的资产实体类型。"

msgid "farmOS Log"
msgstr "农场管理系统日志"

msgid "Provides additional Log entity features for farmOS."
msgstr "为农场管理系统提供额外的日志实体功能。"

msgid "farmOS UI"
msgstr "农场管理系统用户界面"

msgid "Provides default farmOS UI elements (organized into sub-modules by type)."
msgstr "提供默认的农场管理系统用户界面元素（按类型组织为子模块）。"

msgid "farmOS UI Dashboard"
msgstr "农场管理系统仪表板"

msgid "Provides a farmOS dashboard."
msgstr "提供农场管理系统的仪表板。"

msgid "farmOS UI Menu"
msgstr "农场管理系统菜单"

msgid "Provides farmOS menu and toolbar overrides."
msgstr "提供农场管理系统的菜单和工具栏覆盖。"

msgid "farmOS UI Views"
msgstr "农场管理系统视图"

msgid "Provides default Views of farmOS entities."
msgstr "提供农场管理系统实体的默认视图。"

msgid "farmOS Localization"
msgstr "农场管理系统本地化"

msgid "Enables default configuration for localizing/translating farmOS."
msgstr "启用农场管理系统的本地化/翻译默认配置。"

msgid "farmOS Inventory"
msgstr "农场管理系统库存"

msgid "Adds inventory features to quantities."
msgstr "为数量添加库存功能。"

msgid "farmOS Location"
msgstr "农场管理系统位置"

msgid "Provides movement/location tracking for assets via logs."
msgstr "通过日志为资产提供移动/位置跟踪功能。"

msgid "farmOS Map"
msgstr "农场管理系统地图"

msgid "Provides farmOS map features."
msgstr "提供农场管理系统的地图功能。"

msgid "farmOS Flags"
msgstr "农场管理系统标记"

msgid "Provides a general purpose record flagging system."
msgstr "提供通用的记录标记系统。"

msgid "farmOS Login"
msgstr "农场管理系统登录"

msgid "Allows users to login via username and email."
msgstr "允许用户通过用户名和电子邮件登录。"

msgid "farmOS Setup"
msgstr "农场管理系统设置"

msgid "Provides setup pages for farmOS."
msgstr "提供农场管理系统的设置页面。"

msgid "farmOS API"
msgstr "农场管理系统API"

msgid "Provides configuration for the farmOS API."
msgstr "提供农场管理系统的API配置。"

msgid "farmOS Data Stream"
msgstr "农场管理系统数据流"

msgid "Provides a general purpose data stream entity."
msgstr "提供通用的数据流实体。"

msgid "farmOS Notification"
msgstr "农场管理系统通知"

msgid "Provides farmOS notification features."
msgstr "提供农场管理系统的通知功能。"

msgid "farmOS Comment"
msgstr "农场管理系统评论"

msgid "Adds support for comments on farmOS entities."
msgstr "为农场管理系统实体添加评论支持。"

msgid "farmOS Quick Forms"
msgstr "农场管理系统快速表单"

msgid "Provides a framework for farmOS quick forms."
msgstr "为农场管理系统提供快速表单框架。"

msgid "farmOS Report"
msgstr "农场管理系统报告"

msgid "Features for generating and displaying reports."
msgstr "提供生成和显示报告的功能。"

msgid "farmOS Import"
msgstr "农场管理系统导入"

msgid "Features for importing records."
msgstr "提供导入记录的功能。"

msgid "farmOS Export"
msgstr "农场管理系统导出"

msgid "Features for exporting records."
msgstr "提供导出记录的功能。"

msgid "farmOS Role"
msgstr "农场管理系统角色"

msgid "Provides default farmOS user roles and permissions."
msgstr "提供默认的农场管理系统用户角色和权限。"

msgid "farmOS Entity"
msgstr "农场管理系统实体"

msgid "Adds opinionated entity and field configuration to farmOS entity types."
msgstr "为农场管理系统实体类型添加规范的实体和字段配置。"

